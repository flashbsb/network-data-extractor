{
    "_help": "Main orchestrator execution and discovery crawler settings.",
    "extractor": {
        "_help_extractor": "Main orchestrator execution settings. Controls concurrency and output destinations.",
        "threads": 10,
        "randomize_order": true,
        "output_base_dir": "infos",
        "elements_file": "config/elements.cfg",
        "commands_file": "config/commands.cfg",
        "log_level": "INFO"
    },
    "discovery": {
        "_help_discovery": "Settings for recursive network crawler. default_hops determines depth; preferred_management_subnets prioritizes election for multi-IP nodes.",
        "default_hops": 3,
        "preferred_management_subnets": [
            "10.0.1.0/24",
            "172.17.2.0/23"
        ],
        "fallback_cmd_keys": [
            "cisco_ios",
            "cisco_ios_xe",
            "cisco_nxos",
            "cisco_ios_xr",
            "datacom_dmos",
            "huawei_vrp"
        ],
        "output_filename": "discovery.elements.cfg",
        "ignore_new_prefixes": [
            "CPE",
            "BR-",
            "DM",
            "DR",
            "FW",
            "RTCE",
            "SDCE",
            "EDGE",
            "swti"
        ],
        "hostname_format": "simple"
    },
    "web_admin": {
        "_help_web_admin": "Embedded administration portal and REST API parameters.",
        "enabled": true,
        "host": "127.0.0.1",
        "port": 8080,
        "session_ttl_hours": 4
    }
}
